api-end-user-payroll [icon: user]
api-end-user-sales[icon: user]
devops[icon: user]

AWS-IaaS{
  DMZ{
    RProxy [icon: nginx]
  }
  Bastion{
    SSHSrv [icon: vpn]
  }

  DockerEngine [icon: aws-vpc] {
    NETWORK-GATEWAY{
      ms-api-gateway [icon: nginx]
    }
    NETWORK-PAYROLL-EMPLOYEES{
        ms-payroll-employees-get[icon: spring]
        ms-payroll-employees-post[icon: spring]
        ms-payroll-employees-database [icon: mysql]
        ms-payroll-employees-volume [icon: database]
    }
    NETWORK-PAYROLL-DEPARTMENTS{
        ms-payroll-departments[icon: spring]
        ms-payroll-departments-database [icon: mysql]
        ms-payroll-departments-volume [icon: database]
    }
    NETWORK-SALES{
        ms-customers[icon: express]
        ms-customers-database[icon: sqlite]
    }
  }
}

// relations
// Outbound - DMZ
api-end-user-payroll   - RProxy : "443 : TCP \n \ndev.devopsteamxx.vir1.cld.education\n\n/api/vx/departments \n\n \n/api/vx/employees \n\n"
api-end-user-sales   - RProxy : "443 : TCP \n \ndev.devopsteamxx.vir1.cld.education\n\n/api/vx/customers"
devops - SSHSrv : "22 : TCP \n\n/dev.bastion.devopsteamxx.vir1.cld.education/"

// DMZ - Docker Engine
RProxy   - ms-api-gateway : "9000 : TCP"

// Bastion
SSHSrv - DockerEngine : "22 : TCP"

// Inside Docker Engine
ms-api-gateway - ms-payroll-employees-get : "8080-get : TCP"
ms-api-gateway - ms-payroll-employees-post : "8080-post : TCP"
ms-payroll-employees-get - ms-payroll-employees-database : "3306 : TCP"
ms-payroll-employees-post - ms-payroll-employees-database : "3306 : TCP"
ms-payroll-employees-database - ms-payroll-employees-volume

ms-api-gateway - ms-payroll-departments : "8080 : TCP"
ms-payroll-departments - ms-payroll-departments-database : "3306 : TCP"
ms-payroll-departments-database - ms-payroll-departments-volume

ms-api-gateway - ms-customers : "3000 : TCP"
ms-customers - ms-customers-database